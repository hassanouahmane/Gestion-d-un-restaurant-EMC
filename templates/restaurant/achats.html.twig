{% extends 'base.html.twig' %}
{% block title %}Achats fournisseurs{% endblock %}
{% block body %}
<h1>Achats fournisseurs</h1>
<p><a href="{{ path('gestion') }}">Retour au tableau de bord</a></p>
<section><h2>Créer un achat</h2>
<form method="post" class="row">
    <input type="hidden" name="_token" value="{{ csrf_token('achats') }}">
    <input type="hidden" name="operation" value="creer">
    <label>Fournisseur <select name="fournisseur" required>{% for fournisseur in fournisseurs %}<option value="{{ fournisseur.id }}">{{ fournisseur.nom }}</option>{% endfor %}</select></label>
    <button>Créer le brouillon</button>
</form></section>
{% for achat in achats %}
    <section>
        <h2>Achat #{{ achat.id }} · {{ achat.nom }}</h2>
        <p>{{ achat.date_achat }} · {{ achat.statut }}</p>
        <ul>{% for ligne in lignes|filter(ligne => ligne.achat_id == achat.id) %}
            <li>{{ ligne.nom }} · {{ ligne.quantite }} {{ ligne.unite_achat }} à {{ ligne.prix_unitaire }} DH par unité d’achat
                {% if ligne.produit_achete_id %} · fiche produit #{{ ligne.produit_achete_id }}{% endif %}</li>
        {% else %}<li>Aucune ligne.</li>{% endfor %}</ul>
        {% if achat.statut == 'brouillon' %}
            <form method="post" class="row">
                <input type="hidden" name="_token" value="{{ csrf_token('achats') }}">
                <input type="hidden" name="achat" value="{{ achat.id }}">
                <input type="hidden" name="operation" value="ligne">
                <label>Ingrédient <select name="ingredient" required>{% for id, ingredient in ingredients %}<option value="{{ id }}">{{ ingredient.nom }}</option>{% endfor %}</select></label>
                <label>Quantité <input type="number" name="quantite" step="0.0001" min="0.0001" required></label>
                <label>Unité <select name="unite">{% for unite in ['g', 'kg', 'ml', 'cl', 'l', 'piece'] %}<option>{{ unite }}</option>{% endfor %}</select></label>
                <label>Prix unitaire en DH <input type="number" name="prix" min="0" step="0.01" required></label>
                <label>Produit lié <select name="produit"><option value="">Sans fiche</option>{% for produit in produits %}<option value="{{ produit.id }}">{{ produit.nom }} · {{ produit.code_barres }}</option>{% endfor %}</select></label>
                <button>Ajouter la ligne</button>
            </form>
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('achats') }}">
                <input type="hidden" name="achat" value="{{ achat.id }}">
                <button name="operation" value="recevoir">Réceptionner et entrer en stock</button>
            </form>
        {% endif %}
    </section>
{% else %}<p>Aucun achat enregistré.</p>{% endfor %}
{% endblock %}
