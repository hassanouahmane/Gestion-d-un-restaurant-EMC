{% extends 'base.html.twig' %}
{% block title %}Connexion équipe{% endblock %}
{% block body %}
<h1>Connexion équipe</h1>
{% if erreur %}<p class="message erreur" role="alert">Identifiant ou mot de passe incorrect.</p>{% endif %}
<form method="post" action="{{ path('connexion') }}">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <label>Identifiant <input name="_username" value="{{ identifiant }}" autocomplete="username" required></label>
    <label>Mot de passe <input type="password" name="_password" autocomplete="current-password" required></label>
    <button>Se connecter</button>
</form>
{% endblock %}
